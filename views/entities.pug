extends layout

block head
  link(rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css")

block content
  main.container
    header.hero
      .hero-text
        h1 Entity Explorer
        p Alle gesammelten HA-Entities aus MongoDB
      .hero-right
        a.nav-link(href=".") Builder
        a.nav-link(href="settings") Settings
        span.hero-badge Smart Reminders
    section.card
      .entity-toolbar
        .search-row
          input#entitySearch(type="search" placeholder="Domain oder Entity ID filtern..." autocomplete="off")
        span#entityCount.results-info —
      #entity-table
    section#entity-detail.card.is-hidden
      .detail-header
        span#detail-entity-id.detail-title
        span#detail-domain-badge.badge
        button#detail-close.secondary(type="button") ✕
      .detail-grid#detail-attributes

block scripts
  script(src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js")
  script(src="entities.js")
