extends layout

block content
  main.container
    header.hero
      .hero-text
        h1 Entity Explorer
        p Entitäten aus MongoDB und Home Assistant
      .hero-right
        a.nav-link(href="/") Builder
        span.hero-badge Smart Reminders
    section.card
      h2.card-title MongoDB Entity Viewer
      form.search-form(method="get" action="/entities")
        label(for="entityQuery") Entity suchen
        .search-row
          input#entityQuery(type="text" name="q" placeholder="z.B. light.kitchen" value=entityQuery)
          button(type="submit") Suchen
      if entityQuery
        if entities.length
          p.results-info #{entities.length} Treffer für "#{entityQuery}"
          .entity-list
            each entity in entities
              .entity-card
                .entity-header
                  h3= entity.entityId
                  span.badge= entity.domain
                p
                  strong State
                  |  #{entity.state || "null"}
                p
                  strong Last seen
                  |  #{new Date(entity.lastSeen).toLocaleString("de-DE")}
                if entity.attributes
                  pre= JSON.stringify(entity.attributes, null, 2)
        else
          p.results-info Keine Treffer für "#{entityQuery}".
    if error
      section.card.error
        h2.card-title Home Assistant Fehler
        p= error
    else if status
      section.card
        h2.card-title Home Assistant Status
        pre= JSON.stringify(status, null, 2)
    else
      section.card
        h2.card-title Home Assistant Status
        p Noch keine Daten.
